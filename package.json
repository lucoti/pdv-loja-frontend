{
  "name": "pdv-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Página web do PDV da loja FitMoveOn — React + TypeScript + Vite",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gerar:tipos": "npx -y -p openapi-typescript@7 -p typescript@5 openapi-typescript ../backend/contrato/openapi.yaml -o src/api/tipos.gerados.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "msw": {
    "workerDirectory": [
      "simulado-publico"
    ]
  },
  "dependencies": {
    "@fontsource/libre-franklin": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
